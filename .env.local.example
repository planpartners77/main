# 이 파일을 복사해 .env.local로 저장하고 실제 값을 채운다. .env.local은 .gitignore에 의해 커밋되지 않는다.

# Supabase 프로젝트 설정 (Dashboard > Settings > API에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://yozlotwdjiyhbmcadtto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 서버 전용(admin 작업, 마이그레이션 스크립트 등). 절대 클라이언트 번들에 노출하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오/구글 OAuth Client ID·Secret은 더 이상 환경변수가 아니라 관리자 화면
# (/admin/login-methods)에서 직접 입력·수정한다(oauth_credentials 테이블, 0034 마이그레이션).
# 이 파일은 git에 커밋되는 템플릿이므로 절대 실제 키값을 채워 넣지 말 것 — 실제 키는
# .env.local(gitignore 대상)에만 두거나, 카카오/구글 OAuth 키는 위 관리자 화면에 입력한다.
# CI(연계정보) 해시에 섞는 임의 문자열(pepper). 원본 CI는 저장하지 않고
# sha256(CI + CI_HASH_PEPPER)만 profiles.ci_hash에 저장한다. 운영 환경에서만 긴 무작위값으로 설정.
CI_HASH_PEPPER=

# 실제 서비스 도메인은 https://planpartner.co.kr로 확정됨(Vercel 연결·인증 완료).
# 로컬 개발용 값은 아래처럼 localhost로 두면 되고, 프로덕션 값은 Vercel 프로젝트의
# Production 환경변수로 별도 설정한다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 회원가입/여행 신청서 접수 시 텔레그램 알림 (@BotFather로 봇 생성 후 토큰 발급,
# 해당 봇과 대화 시작 후 getUpdates로 chat_id 확인). 둘 다 없으면 알림은 조용히 스킵됨.
# TELEGRAM_CHAT_ID는 콤마로 여러 개(개인+그룹 등) 지정 가능: "111111,-1009876543210"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
